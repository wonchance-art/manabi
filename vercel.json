{
  "git": {
    "deploymentEnabled": {
      "codex/*": false,
      "codex2/*": false,
      "claude/wip/**": false
    }
  },
  "regions": ["hnd1"],
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "crons": [
    {
      "path": "/api/cron/fetch-suggestions",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/backfill-ipa",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/cron/send-forecast",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/analysis-jobs",
      "schedule": "45 17 * * *"
    }
  ]
}
