# Safe fixture defaults only. Copy to .env.local for local development.
# Replace these THREE values with a DEVELOPMENT Supabase project and your app URL
# for actual login/storage. NEXT_PUBLIC_* values are embedded at build time.
# npm run *:cloud always overrides these with fixtures; it cannot verify live login.
NEXT_PUBLIC_SUPABASE_URL=https://e2e.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=e2e-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server API credentials: leave blank unless testing the feature.
# Real credentials belong in local ignored files or the Cloud secret settings.
GEMINI_API_KEY=
GROQ_API_KEY=
SUPADATA_API_KEY=
QIITA_TOKEN=

# Optional cron/push/relay. Do not add a service-role key for ordinary learning UI.
# CRON_SECRET blank => cron fails closed; no VAPID keys => push is unavailable.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
MANABI_AI_RELAY_CLAUDE_TOKEN=
MANABI_AI_RELAY_CODEX_TOKEN=
MANABI_AI_RELAY_URL=
MANABI_AI_RELAY_TOKEN=

# Optional telemetry. LLM_LOG can contain learning data; leave disabled by default.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
NEXT_PUBLIC_SENTRY_DSN=
LLM_LOG=

# Developer/browser overrides are optional; Cloud setup installs Chromium itself.
# PLAYWRIGHT_BROWSER_CHANNEL=chrome
# PLAYWRIGHT_EXECUTABLE_PATH=/path/to/your/browser
# PLAYWRIGHT_BROWSERS_PATH=/path/to/persistent/browser-cache
# NEXT_PUBLIC_WORLD_DEV_GUEST=1  # development only, never authorization
# WORLD_DATA_REF=world-data    # optional read-only world snapshot restoration
