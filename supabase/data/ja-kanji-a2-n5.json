 "openDecisions": [
  "A-1(급수 밖 → 가나) vs A-2(급수 밖도 한자 + 후리가나) — 표기(text) 칸 전체"
 ],
 "textDecided": {},
 "resolved": [
  "こども: base_form 子供 · text 子ども",
  "うち: 표제어 고정 안 함",
  "ともだち: base_form 友達(표기는 A-1/A-2 뒤)",
  "합성어 분할(朝ご飯 vs あさごはん): 범위 밖 — 보드 별도 과제"
 ],
 "numberCounterRule": "숫자 + 조수사(時 · 分 · 月 · 枚 · 匹 · 本 · 冊 · 個 · 歳 · 人)는 한 토큰으로 고정하고 furigana에 읽기 전체를 붙인다(9時 → くじ · 4月 → しがつ · 7時 → しちじ — 時 위에 じ만 붙이면 숫자 읽기가 빠진다, 오케스트레이터 11/11 13:31 KST). 운영에 이미 한 토큰인 9時 · 5時 · 8時 · 7時(id 61) · 3個 · 18歳 · 5人(id 62)은 그대로 둔다(furigana 확인만). base_form은 숫자 포함 표기(7時) — 기존 한 토큰 관례와 같다.",
 "a2": {
  "decision": "오너 11/11 KST — N5 본문 표기 A-2(자연 표기 + 후리가나 전부). 경계: 공개 N5 문법 #1~#9(id 45 · 73 · 74 · 46 · 47 · 49 · 48 · 56 · 57 · 50 · 54)는 가나 중심 — 표제어 · 분할 보정만. #10~#23(14편)만 표기 전환.",
  "naturalRule": "자연 표기 = 일반 출판물(교과서 · NHK やさしい日本語 관행)이 한자로 쓰는 말은 한자, 보통 가나로 쓰는 말(ある · いる · する · できる · こと · もの · ください · 지시어 こ/そ/あ/ど · 부사 とても · もう · ちょっと · ゆっくり · あまり · 감탄사 · 외래어)은 가나. 후리가나는 운영 관례: 명사 = 원래 가나 표기, 동사 · 형용사 = 기본형 읽기, 숫자 + 조수사 = 읽기 통째. 日本 = にほん(분석기 にっぽん을 쓰지 않음). 상용한자표 밖 읽기 · 아테지는 가나(おいしい · すし · おなか). 머리줄 「오늘 만나는 한자」가 소개한 한자는 그 편 본문에서 한자.",
