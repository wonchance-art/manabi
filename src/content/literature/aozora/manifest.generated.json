          ],
          "evidenceUrl": "https://www.aozora.gr.jp/cards/000148/card752.html"
        },
        "colophon": {
          "sourceBook": [
            "「ちくま日本文学全集　夏目漱石」筑摩書房",
            "1992（平成4）年1月20日第1刷発行"
          ],
          "parentBook": [
            "「夏目漱石全集2」ちくま文庫、筑摩書房",
            "1987（昭和62）年10月27日第1刷発行"
          ],
          "inputter": "真先芳秋",
          "proofreader": "柳沢成雄"
        },
        "edits": [
          "ruby-reading-aid",
          "chapter-split-by-manabi"
        ]
      },
      "chapters": [
        {
          "order": 1,
          "title": "一 (1/3)",
          "incipit": "親譲りの無鉄砲で小供の時から損ばかりしている。",
          "sha256": "7ffd998c742c72b524e8177884aa3b9b235b88e6580596718fb5ad5e65730097"
        },
        {
          "order": 2,
          "title": "一 (2/3)",
          "incipit": "母が死んでから清はいよいよおれを可愛がった。",
          "sha256": "9907b3b6e526aa4c806a59c9f8a03f98634bf476a3b53dd70b0cca175a0ec75f"
        },
        {
          "order": 3,
          "title": "一 (3/3)",
          "incipit": "兄とおれはかように分れたが、困ったのは清の行く先である。",
          "sha256": "7e58bdd4d2c67d00468cde38862150d99f60ed4320b136a60e23016d1ec82634"
        },
        {
          "order": 4,
          "title": "二 (1/2)",
          "incipit": "ぶうと云って汽船がとまると、艀が岸を離れて、漕ぎ寄せて来た。",
          "sha256": "813d5291b1e7b3cc78b205aacf4ca3db732f59381c8fc1344a79a4df48e05b66"
        },
        {
          "order": 5,
          "title": "二 (2/2)",
          "incipit": "そう、こうする内に喇叭が鳴った。",
          "sha256": "882f070a8857c40842eae81ffa2a76b40c43e05c57a8ae433773b827354fc422"
        },
        {
          "order": 6,
          "title": "三 (1/2)",
          "incipit": "いよいよ学校へ出た。",
          "sha256": "bb47013b5504ccf3d1cb8b705b2bc89e67acde7565265e61e206825b3e312d23"
        },
        {
          "order": 7,
          "title": "三 (2/2)",
          "incipit": "そのうち学校もいやになった。",
          "sha256": "f6aae2a9ecf257c330ae6db3c540bca00f9b94fdf545a81ad547815452561842"
        },
        {
          "order": 8,
          "title": "四 (1/3)",
          "incipit": "学校には宿直があって、職員が代る代るこれをつとめる。",
          "sha256": "7d70eea8669815a1ee4bf229fa517d0757a4740dc65a58805dceb5439875dd7d"
        },
        {
          "order": 9,
          "title": "四 (2/3)",
          "incipit": "「バッタを知らないのか、知らなけりゃ見せてやろう…",
          "sha256": "8ff1f725b3385acd4d6458c1f1e6f7ca9627cf4fcb80b849eb1035c8af7b12a3"
        },
        {
          "order": 10,
          "title": "四 (3/3)",
          "incipit": "清の事を考えながら、のつそつしていると…",
          "sha256": "c7fd7eb23195c553831f381efc327991b9656fb1adaf61d027ab9a2739f3994a"
        },
        {
          "order": 11,
          "title": "五 (1/3)",
          "incipit": "君釣りに行きませんかと赤シャツがおれに聞いた。",
          "sha256": "269794bc90c29c5ceba24aee437f85b6533c2c3c4a9dff80c85c1abc3ae3e10b"
        },
        {
          "order": 12,
          "title": "五 (2/3)",
          "incipit": "ここいらがいいだろうと船頭は船をとめて、錨を卸した。",
          "sha256": "7946244aea310fb62397ed8f60d8d2b3bf0a6ba26bbc5d9d1f3a201e31eee780"
        },
        {
          "order": 13,
          "title": "五 (3/3)",
          "incipit": "もう帰ろうかと赤シャツが思い出したように云うと…",
          "sha256": "938f93cc68920f6b0addd741a1004da18efc9651771ee52208f4c4935621854f"
        },
        {
          "order": 14,
          "title": "六 (1/4)",
          "incipit": "野だは大嫌いだ。",
          "sha256": "c9c6babdc955aa8ec9ac109350d821c5c07f75b5c45ae218fee7d73cc69b61eb"
        },
        {
          "order": 15,
          "title": "六 (2/4)",
          "incipit": "「冗談じゃない本当だ。",
          "sha256": "e2db6119b68d74d42379f09f86cdf64df0bad861f5bcee588d3307eaf9ecab26"
        },
        {
          "order": 16,
          "title": "六 (3/4)",
          "incipit": "おれは校長の言葉を聞いて…",
          "sha256": "79caf9a5204b371e207867dfd79c96803302f5c1c4d17bd7afd539dfdb548181"
        },
        {
          "order": 17,
          "title": "六 (4/4)",
          "incipit": "しばらくして山嵐はまた起立した。",
          "sha256": "b897003473ae76823b055c6520cd3a12dfcbbfd2a51d83f78ac5db45f6925e15"
        },
        {
          "order": 18,
          "title": "七 (1/4)",
          "incipit": "おれは即夜下宿を引き払った。",
          "sha256": "7052ca180d866d66685a64871e3bdc2942c60b27ebbf685ce636df55df1d97c3"
        },
        {
          "order": 19,
          "title": "七 (2/4)",
          "incipit": "「厄介だね。",
          "sha256": "c1d8e0744b6fe86c9093d746e914f3de7c044e53899b79172fe1eed4b5d44424"
        },
        {
          "order": 20,
          "title": "七 (3/4)",
          "incipit": "おれが椽鼻で清の手紙をひらつかせながら…",
          "sha256": "58c7b390ee6aa09c2d81bae7c9e985d7828c3a3398fff63b3eca30ed0f192387"
        },
        {
          "order": 21,
          "title": "七 (4/4)",
          "incipit": "温泉へ着いて、三階から、浴衣のなりで湯壺へ下りてみたら…",
          "sha256": "8de516fb589a2ba85cb6ced347cd76072fdfc5246cf226eaf1d8040f2de2cbc5"
        },
        {
          "order": 22,
          "title": "八 (1/3)",
          "incipit": "赤シャツに勧められて釣に行った帰りから、山嵐を疑ぐり出した。",
          "sha256": "638edb79e6b5c767f8fc7a6c8ec631cc9bf472edb68e1be16a1e3ba26dfe73cf"
        },
        {
          "order": 23,
          "title": "八 (2/3)",
          "incipit": "「時間が減って、もっと働くんですか、妙だな」",
          "sha256": "8fa5c1eabc952c2260c15ad0c9a918b3e32d2db06ca344b9054529370f5c6caa"
        },
        {
          "order": 24,
          "title": "八 (3/3)",
          "incipit": "小倉の袴をつけてまた出掛けた。",
          "sha256": "435438d3a9cb4baf9d5e7de10baef1c7fdb878c0357ec61ff09736a76c1b34aa"
        },
        {
          "order": 25,
          "title": "九 (1/3)",
          "incipit": "うらなり君の送別会のあるという日の朝、学校へ出たら…",
          "sha256": "d7c4bd76b8f8cc0189de1dc0c9b5fc43df5869fd6cb7cadea7d40bb75fce922a"
        },
        {
          "order": 26,
          "title": "九 (2/3)",
          "incipit": "二人が着いた頃には、人数ももう大概揃って…",
          "sha256": "ac93e057fdbc876df8ee8310a902397375a816ddc9e1c7f2d67dcaec8bf0c969"
        },
        {
          "order": 27,
          "title": "九 (3/3)",
          "incipit": "「ハイカラ野郎の、ペテン師の、イカサマ師の、猫被りの…",
          "sha256": "e88667f7211933bbc0f935aec1258743c23d947f7a3f63200b2d142f18d20802"
        },
        {
          "order": 28,
          "title": "十 (1/3)",
          "incipit": "祝勝会で学校はお休みだ。",
          "sha256": "5470183bcc07730df459f2c56e8b5989811164c4fbf29d3092e336ccc0a0a0f3"
        },
        {
          "order": 29,
          "title": "十 (2/3)",
          "incipit": "おれは筆と巻紙を抛り出して…",
          "sha256": "d85a217a4ce0346f18a237c1248d0a91f2d71f77aa8c7bab56f9c3a47f931412"
        },
        {
          "order": 30,
          "title": "十 (3/3)",
          "incipit": "式の時はさほどでもなかったが、今度は大変な人出だ。",
          "sha256": "d88c98e2c58b7eb613a4e70421a2bc7ccffd6a370e0eaf51db62172672ae63d0"
        },
        {
          "order": 31,
          "title": "十一 (1/4)",
          "incipit": "あくる日眼が覚めてみると、身体中痛くてたまらない。",
