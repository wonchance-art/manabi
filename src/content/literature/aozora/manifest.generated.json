      "chapters": [
        {
          "order": 1,
          "title": "1/4",
          "incipit": "ゴーシュは町の活動写真館でセロを弾く係りでした。",
          "sha256": "0ce79481fbfbb43df4e7924c07b83d700452c76e5d4445c7219e584e894f5d3e"
        },
        {
          "order": 2,
          "title": "2/4",
          "incipit": "「先生もうたくさんです。",
          "sha256": "68979ff5356fad4dfa4bddafa4c41513d8690ecf4596044e925b93db5d2b241d"
        },
        {
          "order": 3,
          "title": "3/4",
          "incipit": "「何だ、硝子へばかだなあ。",
          "sha256": "60b46f5b14890b2d5d360291b8810da9e90e8d3fbeb1b6398dfe2ab496455b88"
        },
        {
          "order": 4,
          "title": "4/4",
          "incipit": "「はい、ここらのものは病気になるとみんな先生のお…",
          "sha256": "92b22618653b1d094658de502d3f0cdab408a942de396a15c9b9d87cb1d461b7"
        }
      ]
    },
