      "chapters": [
        {
          "order": 1,
          "title": "1/3",
          "incipit": "高瀬舟は京都の高瀬川を上下する小舟である。",
          "sha256": "039d25e894ad8ac7800b1ef4a4322c22352d157fdf52b6bf8d25f4af32317257"
        },
        {
          "order": 2,
          "title": "2/3",
          "incipit": "喜助はことばをついだ。",
          "sha256": "29535dce9c5b5e14180ceae22c4fb9d90a34b48d020e69d0cb38c90d2a1d79db"
        },
        {
          "order": 3,
          "title": "3/3",
          "incipit": "喜助はひどく恐れ入った様子で…",
          "sha256": "14a28fd0e27ce49f6b06e42e931300c36f9fcf8fc54348e79e173f178d1f8921"
        }
