        "titleKo": "도련님",
        "authorKo": "나쓰메 소세키",
        "cover": "sky",
        "motif": "steam-sea"
      },
      "literature": {
        "schemaVersion": 1,
        "provider": "aozora",
        "workKey": "aozora-000148-000752",
        "personId": "000148",
        "workId": "752",
        "title": "坊っちゃん",
        "author": "夏目漱石",
        "publishedYear": 1906,
        "authorDeathYear": 1916,
        "charset": "新字新仮名",
        "cardUrl": "https://www.aozora.gr.jp/cards/000148/card752.html",
        "sourceFileUrl": "https://www.aozora.gr.jp/cards/000148/files/752_ruby_2438.zip",
        "sourceSha256": "53c4d86033d0e4590c0354df5fec2709820ef21c09fa402826ff33376ec21228",
        "textSha256": "ece4fc71aad3bed366e86851e818a2525d47fdd732f503866cf7aa084eef6a92",
        "attribution": {
          "author": "夏目漱石",
          "translator": null,
