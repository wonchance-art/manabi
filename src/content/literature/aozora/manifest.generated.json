      "chapters": [
        {
          "order": 1,
          "title": "1/4",
          "incipit": "十月早稲田に移る。",
          "sha256": "b8bc82945c21cf696ee63c2645542d563fa84d77a968469caf7c2e178896d8c9"
        },
        {
          "order": 2,
          "title": "2/4",
          "incipit": "文鳥の眼は真黒である。",
          "sha256": "4569566201914074535e765970096878bcbbfca087a6c67aa865b6346b7e190a"
        },
        {
          "order": 3,
          "title": "3/4",
          "incipit": "餌壺にはまだ粟が八分通り這入っている。",
          "sha256": "82450aaad94856462e5f1c3924b5ff04f28bcce07182b39ce7d6e3dc95a639dd"
        },
        {
          "order": 4,
          "title": "4/4",
          "incipit": "自分は急に易籠を取って来た。",
          "sha256": "5fece9cce0830c4a56404bf0962f52485760c52ef2fd5f9edea114c3d8ab3d63"
        }
      ]
    },
