      "chapters": [
        {
          "order": 1,
          "title": "1/2",
          "incipit": "隴西の李徴は博学才穎、天宝の末年…",
          "sha256": "00137bc85b71de4da5ba89ae76ee04bbfeb4f5d021d64ef936370c7363373dbd"
        },
        {
          "order": 2,
          "title": "2/2",
          "incipit": "他でもない。",
