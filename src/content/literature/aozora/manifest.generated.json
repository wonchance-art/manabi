      "chapters": [
        {
          "order": 1,
          "title": "一",
          "incipit": "これは、私が小さいときに…",
          "sha256": "486b3148b96ebf9245817e3825d1f97f9ee774f3a15c9139b0d8ea9a857d933d"
        },
        {
          "order": 2,
          "title": "二",
          "incipit": "十日ほどたって、ごんが、弥助というお百姓の家の裏…",
          "sha256": "91cd18764402affab0f2341d1ee288eab1f1dcd3fff4e20de6ce6289c50cc805"
        },
        {
          "order": 3,
          "title": "三",
          "incipit": "兵十が、赤い井戸のところで、麦をといでいました。",
          "sha256": "c5b2c9e90f9a74e39d1e5698f0778b70aaed7cbfc66bf3f95214766b45b54759"
        },
        {
          "order": 4,
          "title": "四",
          "incipit": "月のいい晩でした。",
          "sha256": "77ecc77e2af02c957a7d7cd264d006dec8c4531009a9d53d9c313ffd6703bdfa"
        },
        {
          "order": 5,
          "title": "五",
          "incipit": "ごんは、おねんぶつがすむまで…",
          "sha256": "10e45ce6f7ff4f5dc7d56148746b58ac4d8880b5331703d2bc37915f8d1b9e43"
        },
        {
          "order": 6,
          "title": "六",
          "incipit": "そのあくる日もごんは、栗をもって、兵十の家へ出かけました。",
          "sha256": "36bc23076c33c0f85147d1a7d9cee1fd08a14ef3edff2762a982e10cb4fcbe4c"
        }
      ]
    },
